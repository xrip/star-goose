/* Entity — сериализованная запись 23 байта, НЕ host C struct.
 * Одно и то же поле state используется разными обработчиками по-разному.
 * У всех объектов нет общего vx/vy/health: такие имена здесь были бы ложными. */
.equ E_FLAGS             ,  0    # +00: u8: bit0 render, bit1 update; прочие биты контекстны.
.equ E_PARAM             ,  1    # +01: u8: параметр конкретного обработчика, не единое здоровье всех объектов.
.equ E_LAYER             ,  2    # +02: u8: слой 1..7; 7 рисуется первым, 0 не рисуется.
.equ E_Z                 ,  3    # +03: i8: проекционная высота, вычитается из экранного Y.
.equ E_FRAME             ,  4    # +04: u8: индекс кадра / вариант рельефа; смысл зависит от handler.
.equ E_X                 ,  5    # +05: u16: X; знаковые проверки выполняются явно в коде.
.equ E_Y                 ,  7    # +07: u16: Y; на поверхности кольцо modulo1024.
.equ E_WIDTH             ,  9    # +09: u8: ширина кадра в пикселях.
.equ E_HEIGHT            , 10    # +0A: u8: высота кадра в строках.
.equ E_ANCHOR_X          , 11    # +0B: i8: горизонтальный anchor.
.equ E_ANCHOR_Y          , 12    # +0C: i8: вертикальный anchor.
.equ E_BANK              , 13    # +0D: u16: байтовый offset в D_segment_bird1, НЕ порядковый индекс банка.
.equ E_SPRITE            , 15    # +0F: u16: offset пикселей в сегменте E_BANK.
.equ E_TRANSPARENT       , 17    # +11: u8: прозрачный цвет 0..15.
.equ E_HANDLER           , 18    # +12: u8: ID handler 0..35; 0 пропускается, 1..35 → таблица[id-1].
.equ E_STATE_13          , 19    # +13: u8: состояние +13; типизировано по handler в docs.
.equ E_STATE_14          , 20    # +14: u8: состояние +14; может быть половиной u16.
.equ E_STATE_15          , 21    # +15: u8: состояние +15; может быть половиной u16.
.equ E_STATE_16          , 22    # +16: u8: состояние +16; возраст/угол/счётчик по handler.
